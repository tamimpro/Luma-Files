<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Explicitly exclude Secure Vault preferences, database, and encrypted files from Auto Backup -->
    <exclude domain="sharedpref" path="luma_vault_security_prefs.xml" />
    <exclude domain="database" path="luma_files_db" />
    <exclude domain="database" path="luma_files_db-shm" />
    <exclude domain="database" path="luma_files_db-wal" />
    <exclude domain="file" path=".luma_secure_vault" />
    <exclude domain="file" path=".luma_vault_v11" />
    <exclude domain="root" path="no_backup" />
</full-backup-content>
